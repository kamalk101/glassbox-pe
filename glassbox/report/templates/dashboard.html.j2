<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>GlassBox PE · cases</title>
  <style>
    :root {
      --bg: #0b1020;
      --panel: #121a2e;
      --panel-2: #17213a;
      --text: #e8edf7;
      --muted: #98a6bf;
      --line: #26324d;
      --cyan: #5ee7ff;
      --green: #62e6a7;
      --yellow: #ffd166;
      --red: #ff6b7a;
      --magenta: #d38bff;
      --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background:
        radial-gradient(circle at 12% -10%, rgba(94, 231, 255, .16), transparent 34rem),
        radial-gradient(circle at 90% 0%, rgba(211, 139, 255, .12), transparent 28rem),
        var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
    }
    a { color: var(--cyan); text-decoration: none; }
    a:hover { text-decoration: underline; }
    code, .mono { font-family: var(--mono); }
    .wrap { max-width: 1200px; margin: 0 auto; padding: 3rem 1.25rem 4rem; }
    .kicker { color: var(--cyan); font-size: .75rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
    h1 { margin: .35rem 0 .2rem; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.05; }
    h2 { margin: 0 0 .8rem; font-size: 1.15rem; }
    .muted { color: var(--muted); }
    .small { font-size: .85rem; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .7rem; margin: 1.4rem 0; }
    .card { padding: 1rem; border: 1px solid var(--line); border-radius: .7rem; background: linear-gradient(180deg, rgba(23, 33, 58, .94), rgba(18, 26, 46, .94)); }
    .card b { display: block; font-size: 1.7rem; line-height: 1.1; }
    .card span { color: var(--muted); font-size: .8rem; }
    .panel { margin-top: 1rem; padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: .75rem; background: rgba(18, 26, 46, .9); }
    .distribution { display: grid; gap: .45rem; margin-top: .8rem; }
    .bar-row { display: grid; grid-template-columns: 7rem 1fr 3rem; gap: .6rem; align-items: center; font-size: .82rem; }
    .bar { height: .65rem; border-radius: 99px; background: var(--panel-2); overflow: hidden; }
    .bar > span { display: block; height: 100%; border-radius: 99px; }
    .bar-clean > span { background: var(--green); }
    .bar-suspicious > span { background: var(--yellow); }
    .bar-malicious > span { background: var(--red); }
    .bar-inconclusive > span { background: var(--magenta); }
    .controls { display: flex; flex-wrap: wrap; gap: .7rem; align-items: end; margin-top: 1rem; }
    label { display: grid; gap: .25rem; color: var(--muted); font-size: .76rem; text-transform: uppercase; letter-spacing: .06em; }
    input, select {
      min-width: 14rem;
      padding: .55rem .7rem;
      border: 1px solid var(--line);
      border-radius: .45rem;
      background: #0d1425;
      color: var(--text);
      font: inherit;
      font-size: .9rem;
    }
    input:focus, select:focus { outline: 2px solid rgba(94, 231, 255, .45); outline-offset: 1px; }
    .table-wrap { overflow-x: auto; margin-top: .9rem; }
    table { width: 100%; border-collapse: collapse; font-size: .88rem; }
    th, td { padding: .55rem .6rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
    th { color: var(--muted); font-size: .73rem; text-transform: uppercase; letter-spacing: .07em; }
    tbody tr:hover { background: rgba(94, 231, 255, .05); }
    .badge { display: inline-block; padding: .1rem .42rem; border: 1px solid var(--line); border-radius: .35rem; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
    .label-clean { color: var(--green); border-color: var(--green); }
    .label-suspicious { color: var(--yellow); border-color: var(--yellow); }
    .label-malicious { color: var(--red); border-color: var(--red); }
    .label-inconclusive { color: var(--magenta); border-color: var(--magenta); }
    .yes { color: var(--green); }
    .no { color: var(--muted); }
    .empty { color: var(--muted); font-style: italic; padding: 1.5rem 0; }
    .nav-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1rem; margin-top: 1rem; }
    .timeline { display: flex; flex-direction: column; gap: .6rem; max-height: 32rem; overflow-y: auto; padding-right: .3rem; }
    .timeline-item { display: grid; grid-template-columns: 8.5rem 1fr auto; gap: .7rem; align-items: center; padding: .55rem .65rem; border: 1px solid var(--line); border-left: 4px solid var(--cyan); border-radius: .45rem; background: var(--panel-2); }
    .timeline-item.clean { border-left-color: var(--green); }
    .timeline-item.suspicious { border-left-color: var(--yellow); }
    .timeline-item.malicious { border-left-color: var(--red); }
    .timeline-item.inconclusive { border-left-color: var(--magenta); }
    .timeline-item .when { color: var(--muted); font-size: .78rem; }
    .timeline-item .item-file { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .activity { display: grid; gap: .45rem; }
    .day-row { display: grid; grid-template-columns: 6.5rem 1fr auto; gap: .6rem; align-items: center; }
    .day-bars { display: grid; gap: .1rem; }
    .day-bar { display: flex; height: .42rem; border-radius: 99px; overflow: hidden; }
    .day-bar.clean { background: var(--green); }
    .day-bar.suspicious { background: var(--yellow); }
    .day-bar.malicious { background: var(--red); }
    .day-bar.inconclusive { background: var(--magenta); }
    .chips { display: flex; flex-wrap: wrap; gap: .4rem; }
    .chip { display: inline-block; padding: .16rem .45rem; border: 1px solid var(--line); border-radius: 99px; background: var(--panel-2); font-size: .75rem; }
    @media (max-width: 900px) {
      .nav-grid { grid-template-columns: 1fr; }
    }
    footer { margin-top: 2rem; color: var(--muted); font-size: .8rem; text-align: center; }
    @media print {
      body { background: #fff; color: #111; }
      .card, .panel { background: #fff; border-color: #bbb; }
      a { color: #0645ad; }
      .muted, footer, label { color: #555; }
      input, select { display: none; }
    }
  </style>
</head>
<body>
<div class="wrap">
  <div class="kicker">GlassBox PE · case dashboard</div>
  <h1>Case index</h1>
  <p class="muted">Offline evidence-first triage · generated {{ generated_at }}</p>

  {% if view.total %}
  <div class="cards">
    <div class="card"><b>{{ view.total }}</b><span>cases</span></div>
    <div class="card"><b>{{ view.counts.clean }}</b><span>clean</span></div>
    <div class="card"><b>{{ view.counts.suspicious }}</b><span>suspicious</span></div>
    <div class="card"><b>{{ view.counts.malicious }}</b><span>malicious</span></div>
    <div class="card"><b>{{ view.average_score }}</b><span>average risk score</span></div>
    <div class="card"><b>{{ view.average_sneakiness }}</b><span>average sneakiness</span></div>
    <div class="card"><b>{{ view.report_coverage }}%</b><span>reports generated</span></div>
    <div class="card"><b>{{ view.emulation_coverage }}%</b><span>emulation coverage</span></div>
  </div>

  <section class="panel">
    <h2>Verdict distribution</h2>
    <div class="distribution">
      {% for item in view.distribution %}
      <div class="bar-row">
        <span>{{ item.label }}</span>
        <div class="bar bar-{{ item.label }}"><span style="width: {{ item.percent }}%"></span></div>
        <span class="muted">{{ item.count }}</span>
      </div>
      {% endfor %}
    </div>
  </section>

  <div class="nav-grid">
    <section class="panel">
      <h2>Activity timeline</h2>
      <div class="timeline">
        {% for item in view.timeline %}
        <div class="timeline-item {{ item.label }}">
          <span class="when">{{ item.created_at[:19] }}</span>
          <span class="item-file" title="{{ item.file_name }}">{{ item.file_name }}</span>
          <span class="mono small">{% if item.report %}<a href="{{ item.report }}">report</a>{% else %}{{ item.label }}{% endif %}</span>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="panel">
      <h2>Verdicts by day</h2>
      <div class="activity">
        {% for day in view.activity_by_day %}
        <div class="day-row">
          <span class="mono small">{{ day.day }}</span>
          <span class="day-bars">
            {% if day.clean %}<span class="day-bar clean" style="width: {{ [day.clean * 100, 100] | min }}%"></span>{% endif %}
            {% if day.suspicious %}<span class="day-bar suspicious" style="width: {{ [day.suspicious * 100, 100] | min }}%"></span>{% endif %}
            {% if day.malicious %}<span class="day-bar malicious" style="width: {{ [day.malicious * 100, 100] | min }}%"></span>{% endif %}
            {% if day.inconclusive %}<span class="day-bar inconclusive" style="width: {{ [day.inconclusive * 100, 100] | min }}%"></span>{% endif %}
          </span>
          <span class="small muted"></span>
        </div>
        {% endfor %}
      </div>
      <h2 style="margin-top: 1rem">Unpack status</h2>
      <div class="chips">
        {% for status, count in view.unpack_counts.items() %}<span class="chip">{{ status }}: {{ count }}</span>{% endfor %}
      </div>
    </section>
  </div>

  <section class="panel">
    <h2>Cases</h2>
    <div class="controls">
      <label>Search
        <input id="search" type="search" placeholder="file name or case id" autocomplete="off">
      </label>
      <label>Verdict
        <select id="verdict">
          <option value="all">all</option>
          <option value="clean">clean</option>
          <option value="suspicious">suspicious</option>
          <option value="malicious">malicious</option>
          <option value="inconclusive">inconclusive</option>
        </select>
      </label>
      <span class="small muted"><span id="visible-count">{{ view.total }}</span> visible</span>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Case</th>
            <th>File</th>
            <th>Verdict</th>
            <th>Score</th>
            <th>Confidence</th>
            <th>Created</th>
            <th>Unpack</th>
            <th>Emulation</th>
            <th>Observed</th>
            <th>Report</th>
          </tr>
        </thead>
        <tbody>
          {% for row in view.cases %}
          <tr data-label="{{ row.label }}" data-search="{{ (row.file_name ~ ' ' ~ row.case_id) | lower }}">
            <td class="mono"><a href="{{ row.case_id }}/case.json">{{ row.case_id[:12] }}</a></td>
            <td>{{ row.file_name }}</td>
            <td><span class="badge label-{{ row.label }}">{{ row.label }}</span></td>
            <td>{{ row.score }}</td>
            <td>{{ "%.2f"|format(row.confidence) }}</td>
            <td class="small muted">{{ row.created_at[:19] }}</td>
            <td>{% if row.unpack_status %}<span class="badge">{{ row.unpack_status }}</span>{% else %}<span class="no">-</span>{% endif %}</td>
            <td>{% if row.emulation_ran %}<span class="yes">yes</span>{% else %}<span class="no">-</span>{% endif %}</td>
            <td>{% if row.observed_ran %}<span class="yes">yes</span>{% else %}<span class="no">-</span>{% endif %}</td>
            <td>{% if row.has_report %}<a href="{{ row.case_id }}/report.html">open</a>{% else %}<span class="no">-</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <noscript><p class="small muted">JavaScript is disabled; all cases are listed.</p></noscript>
  </section>
  {% else %}
  <section class="panel"><p class="empty">No cases yet. Run <code>glassbox scan &lt;file.exe&gt;</code>.</p></section>
  {% endif %}

  <footer>Generated by GlassBox PE · links are relative to this dashboard file</footer>
</div>

{% if view.total %}
<script>
  const search = document.getElementById('search');
  const verdict = document.getElementById('verdict');
  const visible = document.getElementById('visible-count');
  const rows = Array.from(document.querySelectorAll('tbody tr'));

  function applyFilters() {
    const term = search.value.trim().toLowerCase();
    const wanted = verdict.value;
    let count = 0;
    for (const row of rows) {
      const matchesTerm = !term || row.dataset.search.includes(term);
      const matchesVerdict = wanted === 'all' || row.dataset.label === wanted;
      row.hidden = !(matchesTerm && matchesVerdict);
      if (!row.hidden) count += 1;
    }
    visible.textContent = String(count);
  }

  search.addEventListener('input', applyFilters);
  verdict.addEventListener('change', applyFilters);
</script>
{% endif %}
</body>
</html>
